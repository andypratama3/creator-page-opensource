# Public site URL — used for canonical, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://domainkamu.com

# Admin panel password (/admin). Change this in production!
ADMIN_PASSWORD=admin123

# Resend — contact form emails (resend.com → API Keys)
RESEND_API_KEY=
# Optional: verified sender, e.g. "Kontak <halo@domainkamu.com>"
RESEND_FROM=

# Vercel KV + Blob env vars (KV_REST_API_URL, KV_REST_API_TOKEN,
# BLOB_READ_WRITE_TOKEN) are injected automatically when you connect
# Storage in the Vercel dashboard. No need to set them here.
